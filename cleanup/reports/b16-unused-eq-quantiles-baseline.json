    {
      "name": "exp_quantile",
      "line": 45,
      "end_line": 51,
      "text": "def exp_quantile(p: float, scale: float) -> float:\n    \"\"\"\n        Exp distribution has analytical solution for quantile.\n    \"\"\"\n    if not (0.0 < p < 1.0):\n        raise ValueError(\"p must be in (0,1)\")\n    return -float(scale) * math.log(1.0 - float(p))\n",
      "sha256": "52949de9734dead959de55ccf1122cb94df90203fdffa3981e6574b0cdb32134"
    }
