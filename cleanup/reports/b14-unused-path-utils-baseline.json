      "start_line": 291,
      "end_line": 298,
      "text": "# ---------------------------------------------------------------------------\n# New: path consistency helpers (to compare old vs new path building results)\n# ---------------------------------------------------------------------------\n\ndef _normalize_path(p):\n    if p is None:\n        return None\n    return os.path.normpath(p)\n",
